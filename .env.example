# ── RPC endpoints (public defaults work for read-only fork tests) ──────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ── Fork tests against the real EAS predeploys (network access; off by default) ───────────────────────────
# FORK_TESTS=true forge test --match-path 'test/fork/*'
FORK_TESTS=false

# ── Deployment ────────────────────────────────────────────────────────────────────────────────────────────
# Prefer `--account <name>` (forge keystore) or `--ledger` over a raw key. If you must use a raw key:
#   forge script script/Deploy.s.sol --rpc-url base_sepolia --private-key $DEPLOYER_PRIVATE_KEY --broadcast
# NEVER commit a real key. NEVER use a mainnet key for a Sepolia dry run.
DEPLOYER_PRIVATE_KEY=

# Hard guard: the deploy script refuses chain 8453 unless this is exactly "true".
ALLOW_MAINNET=false

# Basescan / Etherscan v2 API key for `--verify` and `forge verify-contract`
BASESCAN_API_KEY=

# ── Filled in by the deploy script output (record here and in the spec address tables) ────────────────────
OTTP_REGISTRY_ADDRESS=
OTTP_SUBJECT_RESOLVER_ADDRESS=
OTTP_OBJECT_RESOLVER_ADDRESS=
OTTP_SUBJECT_SCHEMA_UID=
OTTP_OBJECT_SCHEMA_UID=
